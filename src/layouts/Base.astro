---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  /** Optional share image, a site path like '/images/x.webp'. */
  image?: string;
}

const { title, description, schema = [], image } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = image ? new URL(image, site.url).href : undefined;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  email: site.email,
  description: `${site.tagline} with ${site.name}.`,
  areaServed: site.city || 'Online',
  sameAs: [site.instagram, site.youtube],
};
const allSchema = [localBusiness, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Figtree:wght@400;500;600&display=swap"
    />
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="6yyUx3af9VOk44L8PoxUTg" async></script>
    <!-- Google Analytics 4 (property "Oliver-Glozik", stream oliverglozik.com) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-911NTE3Y2B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-911NTE3Y2B');
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav class="wrap nav" aria-label="Main">
        <a class="logo" href="/">{site.name}</a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links">Menu</button>
        <ul class="nav-links" id="nav-links">
          <li>
            <details class="dropdown">
              <summary>Tools</summary>
              <ul>
                <li><a href="/coaching/">Coaching</a></li>
                <li><a href="/breathwork/">Breathwork</a></li>
                <li><a href="/hypnosis/">Hypnosis</a></li>
                <li><a href="/retreats/">Retreats</a></li>
              </ul>
            </details>
          </li>
          <li><a href="/about/">About</a></li>
          <li><a href="/reviews/">Reviews</a></li>
          <li><a href="/blog/">Blog</a></li>
        </ul>
        <a class="btn" href={site.bookingUrl}>Book a free call</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <h3>Services</h3>
            <ul>
              <li><a href="/coaching/">Coaching</a></li>
              <li><a href="/breathwork/">Breathwork</a></li>
              <li><a href="/hypnosis/">Hypnosis</a></li>
              <li><a href="/retreats/">Retreats</a></li>
            </ul>
          </div>
          <div>
            <h3>More</h3>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/reviews/">Reviews</a></li>
              <li><a href="/blog/">Blog</a></li>
            </ul>
          </div>
          <div>
            <h3>Contact</h3>
            <ul>
              {site.city && <li>{site.city}</li>}
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><a href={site.bookingUrl}>Book a free call</a></li>
            </ul>
          </div>
          <div>
            <h3>Follow me on socials</h3>
            <div class="foot-socials">
            <a class="foot-social" href={site.instagram} target="_blank" rel="me noopener" aria-label="Oliver Glozik on Instagram">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
              </svg>
            </a>
            <a class="foot-social" href={site.youtube} target="_blank" rel="me noopener" aria-label="Oliver Glozik on YouTube">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2.5" y="5" width="19" height="14" rx="4.5" />
                <path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor" />
              </svg>
            </a>
            </div>
          </div>
        </div>
        <div class="foot-bottom">
          © {new Date().getFullYear()} {site.name}. Hypnosis and breathwork support wellbeing and
          work alongside, not instead of, medical care.
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.menu-toggle');
      const links = document.getElementById('nav-links');
      toggle?.addEventListener('click', () => {
        const open = links?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(!!open));
      });
      // Close the Tools dropdown when clicking anywhere outside it.
      document.addEventListener('click', (e) => {
        document.querySelectorAll('details.dropdown[open]').forEach((d) => {
          if (!d.contains(e.target as Node)) d.removeAttribute('open');
        });
      });
    </script>
  </body>
</html>
