---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, seoTitle, description, date, updated, topic } = post.data;

const service = topic === 'hypnosis'
  ? { href: '/hypnosis/', label: 'hypnosis sessions' }
  : { href: '/breathwork/', label: 'breathwork sessions' };

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: site.name, url: site.url },
  publisher: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, site.url).href,
};
---

<Base title={seoTitle ?? `${title} | ${site.name}`} description={description} schema={[articleSchema]}>
  <section class="section">
    <div class="wrap narrow article">
      <div class="eyebrow"><a href="/blog/">Blog</a> · {topic}</div>
      <h1>{title}</h1>
      <p class="muted">
        By {site.name} · <time datetime={date.toISOString()}>{fmt(date)}</time>
        {updated && <> · updated <time datetime={updated.toISOString()}>{fmt(updated)}</time></>}
      </p>

      <Content />

      <aside class="author-box" aria-label="About the author">
        <img src="/images/oliver-glozik-breathwork-facilitator-avatar.webp" alt="Oliver Glozik" width="88" height="88" loading="lazy" />
        <div>
          <div class="eyebrow">About the author</div>
          <h2>Oliver Glozik</h2>
          <p>
            Oliver is a certified breathwork facilitator who also works with hypnosis and coaching. He has sat with more than
            {site.stats[0].value.replace('+', '')} people through breathwork, hypnosis and retreats, and
            his group breathwork was featured on MTV’s <em>The Surreal Life</em>.
          </p>
          <a href="/about/">More about Oliver</a>
        </div>
      </aside>

      <div class="cta-box">
        <h2>Want to try it for yourself?</h2>
        <p>See how my {service.label} work, or book a free call and ask me anything first.</p>
        <div class="btn-row">
          <a class="btn" href={service.href}>About {service.label}</a>
          <a class="btn" href={site.bookingUrl}>Book a free call</a>
        </div>
      </div>
    </div>
  </section>
</Base>
