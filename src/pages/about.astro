---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title={`About Oliver | ${site.name}`}
  description={`About ${site.name}: hypnotherapist, breathwork facilitator and coach. ${site.stats[0].value} lives transformed, ${site.stats[1].value} retreats hosted.`}
>
  <section class="section">
    <div class="wrap split">
      <div class="placeholder">Portrait of Oliver</div>
      <div class="article">
        <h1>Hi, I'm Oliver</h1>
        <p class="lead">
          I'm a hypnotherapist, breathwork facilitator and coach. Over the years I have worked with more
          than a thousand people and hosted over a hundred retreats.
        </p>
        <!-- TODO: Oliver's story, training and certifications -->
        <p>
          My work brings together hypnosis, breathwork and coaching, because I have seen again and again
          that the mind and body change best together.
        </p>
        <h2>Training</h2>
        <p class="muted">Certifications coming soon.</p>
        <div class="btn-row"><a class="btn" href={site.bookingUrl}>Book a free call</a></div>
      </div>
    </div>
  </section>
</Base>
