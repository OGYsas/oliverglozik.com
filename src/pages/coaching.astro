---
import Base from '../layouts/Base.astro';
import { site, where } from '../data/site';
---

<Base
  title={`Personal Coaching ${where} | ${site.name}`}
  description={`One-to-one personal coaching with ${site.name} ${where.toLowerCase()}, combining coaching with hypnosis and breathwork for change that lasts.`}
>
  <section class="section">
    <div class="wrap narrow article">
      <div class="eyebrow">Coaching</div>
      <h1>Personal Coaching {where}</h1>
      <p class="lead">
        Coaching for people who are ready for a real change in their work, relationships or sense of
        direction, and want support that goes deeper than goal-setting.
      </p>
      <div class="btn-row"><a class="btn" href={site.bookingUrl}>Book a free call</a></div>

      <h2>How my coaching is different</h2>
      <p>
        Most coaching works with the conscious mind: plans, goals, accountability. I use those too, but
        I also bring in hypnosis and breathwork to work with the habits and feelings that usually
        derail a plan. That is often where lasting change actually happens.
      </p>

      <h2>How it works</h2>
      <ul>
        <li>A free call to understand where you are and where you want to be.</li>
        <li>A programme of regular one-to-one sessions, online or in person.</li>
        <li>Practices and recordings to use between sessions.</li>
      </ul>

      <div class="cta-box">
        <h2>Let's talk</h2>
        <p>Book a free 20-minute call to see if coaching with me is a fit.</p>
        <a class="btn" href={site.bookingUrl}>Book a free call</a>
      </div>
    </div>
  </section>
</Base>
