---
import Base from '../layouts/Base.astro';
import ReviewList from '../components/ReviewList.astro';
import { site } from '../data/site';
import { reviews } from '../data/reviews';
---

<Base
  title={`Reviews | ${site.name}`}
  description={`${reviews.length} five-star reviews from people who have worked with ${site.name} at retreats, breathwork and one-to-one sessions.`}
>
  <section class="section">
    <div class="wrap">
      <div class="eyebrow">Reviews</div>
      <h1>What people say</h1>
      <p class="lead">
        Five-star reviews from people who have worked with me, at retreats and in sessions.
      </p>
      <ReviewList reviews={reviews} />
      <div class="cta-box">
        <h2>Ready to start?</h2>
        <p>Book a free 20-minute call and we will find the right approach for you.</p>
        <a class="btn" href={site.bookingUrl}>Book a free call</a>
      </div>
    </div>
  </section>
</Base>
