---
import Base from '../layouts/Base.astro';
import { site, where } from '../data/site';
import { problems } from '../data/problems';
---

<Base
  title={`Hypnosis ${where} | ${site.name}`}
  description={`Hypnosis sessions with ${site.name} ${where.toLowerCase()}. Hypnosis combined with breathwork for anxiety, sleep, smoking, weight loss and more.`}
>
  <section class="section">
    <div class="wrap narrow article">
      <div class="eyebrow">Hypnosis</div>
      <h1>Hypnosis {where}</h1>
      <p class="lead">
        Hypnosis uses a relaxed, focused state of mind to change habits, feelings and patterns that
        are hard to shift by willpower alone. I combine it with breathwork, so the change happens in the
        body as well as the mind.
      </p>
      <div class="btn-row"><a class="btn" href={site.bookingUrl}>Book a free call</a></div>

      <h2>What hypnosis feels like</h2>
      <p>
        Most people describe it as deep relaxation with a clear, focused mind. You stay aware and in
        control the whole time, and you can open your eyes whenever you want. Nothing about it is like
        stage hypnosis.
      </p>

      <h2>What I help with</h2>
      <div class="grid grid-2" style="margin-top:16px">
        {
          problems.map((p) => (
            <a class="card" href={`/${p.slug}/`}>
              <h3>{p.h1}</h3>
              <span class="go">Read more →</span>
            </a>
          ))
        }
      </div>
      <p style="margin-top:1em"><a href="/help/">See everything I help with →</a></p>

      <h2>Online or in person</h2>
      <p>
        Online sessions over video work just as well for most people. All you need is a quiet room and a
        pair of headphones. Every session comes with a recording to use at home.
      </p>

      <div class="cta-box">
        <h2>Not sure if hypnosis is right for you?</h2>
        <p>Book a free 20-minute call and ask me anything.</p>
        <a class="btn" href={site.bookingUrl}>Book a free call</a>
      </div>
    </div>
  </section>
</Base>
